# ── 你的知识库数据（引擎与数据分离：数据默认不在此仓库）──
vault/
data/
config.yaml
.env
*.local

# ── 生成的索引与缓存 ──
.llm-wiki/
*.db
*.db-wal
*.db-shm
# demo 的示例内容需要入库，单独放行
!demo/**
# ⚠️ 上面的放行会覆盖前面的忽略规则，所以 demo 里这些要单独再排除：
# 生成物 + 密钥/数据类文件（保证 README 承诺的「config.yaml / .env 永不进 git」在 demo 下同样成立）
**/.llm-wiki/
demo/**/*.db
demo/**/*.db-wal
demo/**/*.db-shm
demo/index/dashboard.html
demo/config.yaml
demo/.env
demo/**/*.local
demo/vault/
demo/data/

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# ── 第三方工具克隆位置（引导安装，不进本仓库）──
integrations/chubbyskills/
integrations/_third_party/

# ── Obsidian / 编辑器 / 系统 ──
.obsidian/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
